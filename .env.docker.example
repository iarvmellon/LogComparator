# Copy to .env on the Linux server and adjust as needed.
LOGCOMPARATOR_PORT=4020
# Parallel audit parser workers (default: 4, limited by available CPUs; 1 disables parallel parsing).
LOGCOMPARATOR_PARSE_WORKERS=4
TANGO_LOG_DIR=/opt/tango/log
TANGO_AUDIT_DIR=/opt/tango/audit
# Numeric existing host group that can read both Tango directories.
TANGO_READ_GID=10001
# Optional build metadata:
LOGCOMPARATOR_VERSION=container
LOGCOMPARATOR_GIT_HASH=unknown

# HTTPS certificate folder on the Docker host (server.crt and server.key).
LOGCOMPARATOR_TLS_DIR=./certs

# CPU quota is calculated by docker_compose.sh from the Docker host CPU count minus one for Tango.
# Do not set LOGCOMPARATOR_CPU_LIMIT here; use the helper for Compose operations.
